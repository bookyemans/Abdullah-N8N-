# Configure these as Cloudflare Pages Variables/Secrets, never in public JS.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy fallback: SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Secret: service-role key must only exist in Cloudflare Pages Secret storage.
SUPABASE_SECRET_KEY=SET_ONLY_IN_CLOUDFLARE_SECRET_STORE
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_CLOUDFLARE_SECRET_STORE
TRACKING_HASH_SECRET=SET_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
# Optional Google Sheets mirror. It is ignored unless GOOGLE_SHEETS_ENABLED=true.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_SHEETS_ENABLED=false

# Cloudflare Pages Secret (32+ random characters); never commit its real value.
CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret
