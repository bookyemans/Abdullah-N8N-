# Configure these in Cloudflare Pages > Settings > Variables and Secrets.
# Do not commit actual values.
TELEGRAM_BOT_TOKEN=replace-with-a-new-rotated-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id
# Optional server-side contact notification. Keep this as a Cloudflare Secret.
WEB3FORMS_ACCESS_KEY=replace-with-web3forms-access-key
# Optional Turnstile server secret. Only enable after adding the matching widget to contact.html.
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret

# Initial bootstrap only. After CONFIG_KV is bound and the owner saves settings,
# encrypted KV configuration takes precedence over these fallback values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy fallback: SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=replace-with-public-anon-or-publishable-key
SUPABASE_SECRET_KEY=SET_ONLY_IN_CLOUDFLARE_SECRET_STORE
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
# Configure CONFIG_ENCRYPTION_KEY as a Cloudflare Secret (32+ characters).
# Bind a Cloudflare KV namespace as CONFIG_KV; never commit its credentials.
